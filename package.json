    "validate:links": "node scripts/qa-links-static.mjs",
    "glossary:build": "node tools/build-glossary-pages.mjs",
    "near:build": "node tools/build-near-pages.mjs",
    "schedule:events:build": "node tools/build-schedule-events-jsonld.mjs",
    "qa:near": "node scripts/qa-near-quality.mjs && node scripts/qa-near-fast-facts.mjs",
    "qa:near:facts": "node scripts/qa-near-fast-facts.mjs",
    "qa:citation-phase1": "node scripts/qa-citation-phase1.mjs",
    "redirects:sync": "node tools/sync-htaccess-legacy-redirects.mjs --write",
    "redirects:check": "node tools/sync-htaccess-legacy-redirects.mjs --check",
    "qa:redirects": "npm run redirects:check && node scripts/qa-redirects.mjs",
