    "qa:glossary:contrast": "node scripts/qa-glossary-contrast.mjs",
    "qa:assets:canon": "npm run qa:assets:fingerprint:additive && npm run qa:assets:js-parity",
    "assets:inventory": "node tools/asset-inventory.mjs --json=docs/performance/asset-inventory.json --markdown=docs/performance/asset-inventory.md",
    "qa:assets:size": "node scripts/qa-assets-size.mjs",
    "qa:assets:js-parity": "node scripts/qa-hashed-js-parity.mjs",
    "qa:legacy:script-refs": "npm run qa:assets:fingerprint:additive",
    "qa:cwv:lab": "node scripts/qa-cwv-lab.mjs",
    "qa:repo:clean": "node scripts/qa-repo-clean.mjs",
    "qa:schedule": "node scripts/qa-schedule.mjs",
    "plan:finalize": "bash scripts/plan-finalize.sh",
    "qa:all": "npm run qa:schedule && npm run qa:funnel && npm run qa:links:static && npm run qa:links:existence && npm run qa:css:links && npm run qa:components:bundles && npm run qa:css:minified && npm run qa:icons:local && npm run qa:css:bootstrap && npm run qa:css:routes && npm run qa:css:route-bundles && npm run qa:css:budget && npm run qa:assets:fingerprint:fixture && npm run qa:assets:canon && npm run qa:css:assets:baseline && npm run qa:external:blocked && npm run qa:videos && npm run qa:priority:inlinks && npm run qa:orphans && npm run qa:nav && npm run qa:doctype && npm run qa:ssi && npm run qa:seo && npm run qa:lazy-loading && npm run qa:near && npm run qa:schema && npm run qa:glossary",
