    "qa:doctype": "node scripts/qa-doctype.mjs",
    "qa:ssi": "node scripts/qa-ssi-integrity.mjs && node scripts/qa-ssi-errmsg.mjs && node scripts/qa-ssi-homepage-chain.mjs && node scripts/qa-ssi-leaks.mjs",
    "qa:ssi:integrity": "node scripts/qa-ssi-integrity.mjs",
    "qa:ssi:errmsg": "node scripts/qa-ssi-errmsg.mjs",
    "qa:ssi:homepage": "node scripts/qa-ssi-homepage-chain.mjs",
