    "styles:bootstrap": "node tools/build-bootstrap-site.mjs",
    "styles:routes": "node tools/build-route-styles.mjs --write",
    "styles:routes:prune": "node tools/build-route-styles.mjs --prune-stale",
    "qa:components:bundles": "node tools/build-component-bundles.mjs --check && node scripts/qa-component-bundles.mjs",
    "qa:css:bootstrap": "node tools/build-bootstrap-site.mjs --check",
    "qa:css:routes": "node tools/build-route-styles.mjs --check",
    "qa:css:route-bundles": "node scripts/qa-css-route-bundles.mjs",
    "qa:css:budget": "node scripts/qa-css-budget.mjs",
