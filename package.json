    "qa:links:static": "node scripts/qa-links-static.mjs",
    "qa:links:existence": "node scripts/qa-links-existence.mjs",
    "qa:links:live": "node scripts/qa-links-live.mjs",
    "qa:links:inventory": "node scripts/qa-internal-links.mjs",
    "qa:videos": "node scripts/qa-video-inlinks.mjs",
    "qa:priority:inlinks": "node scripts/qa-priority-inlinks.mjs",
    "qa:orphans": "node scripts/qa-orphans.mjs",
    "qa:schema": "node scripts/qa-schema.mjs",
    "qa:funnel": "node scripts/qa-funnel.mjs",
    "qa:youth-intro": "node scripts/qa-youth-intro-rollout.mjs",
    "campaign:expire-christmas": "node scripts/expire-christmas-in-july.mjs",
    "qa:seo": "node scripts/qa-seo-eleventy.mjs",
    "qa:lazy-loading": "node scripts/qa-lazy-loading.mjs",
    "qa:meta:live": "node scripts/qa-meta-live.mjs",
    "qa:blog:slash:live": "node scripts/qa-blog-slash-live.mjs",
    "qa:sitemaps:live:redirects": "node scripts/qa-sitemap-live-redirects.mjs",
