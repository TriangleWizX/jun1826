{
  "name": "senseisandy-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy && node tools/materialize-ssi-fragments.mjs && node tools/fingerprint-assets.cjs && node tools/ensure-glossary-asset-alias.cjs",
    "clean": "node -e \"import('fs').then(fs => fs.rmSync('dist', {recursive: true, force: true}))\"",
    "validate": "npm run build && node --test scripts/qa-unified.mjs && node scripts/qa-cal-migration.mjs",
    "test": "npm run validate && npm run test:ads",
    "deploy": "python3 scripts/deploy-release.py",
    "qa:unified": "node --test scripts/qa-unified.mjs",
    "qa:cal-migration": "node scripts/qa-cal-migration.mjs",
    "qa:volatile-facts": "node scripts/qa-volatile-operational-facts.mjs",
    "qa:schedule": "node scripts/qa-schedule.mjs",
    "redirects:sync": "node tools/sync-htaccess-legacy-redirects.mjs --write",
    "redirects:check": "node tools/sync-htaccess-legacy-redirects.mjs --check",
    "sitemaps:build": "node tools/build-all-sitemaps.mjs",
    "ads:weekly": "python3 tools/ads/weekly.py",
    "ads:plan": "python3 tools/ads/ads.py plan",
    "ads:render": "python3 tools/ads/ads.py render",
    "ads:brief": "python3 tools/ads/workflow.py",
    "ads:swipe": "python3 tools/ads/swipe.py",
    "ads:scaffold": "python3 tools/ads/scaffold.py",
    "test:ads": "python3 -m unittest discover -s tools/ads -p 'test_*.py'"
  },
  "dependencies": {},
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "bootstrap": "5.3.3",
    "playwright": "^1.62.1",
    "purgecss": "6.0.0",
    "sass": "1.77.8"
  }
}
