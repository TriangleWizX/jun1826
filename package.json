    "videos:json": "npm run playlist:json",
    "videos:pages": "node tools/build-video-watch-pages.mjs && npm run redirects:sync",
    "videos:sitemap": "node tools/build-video-sitemap.mjs",
    "blog:clusters": "node tools/apply-blog-link-clusters.mjs",
    "videos:build": "npm run videos:json && npm run videos:pages && npm run videos:sitemap",
    "sitemaps:pages-blog": "node tools/build-all-sitemaps.mjs",
    "qa:sitemaps:overlap": "node scripts/qa-sitemap-overlap.mjs",
    "sitemaps:index": "node tools/build-all-sitemaps.mjs",
    "sitemaps:build": "node tools/build-all-sitemaps.mjs",
    "icons:build": "node tools/build-bootstrap-icon-subset.mjs",
    "qa:icons:local": "node tools/build-bootstrap-icon-subset.mjs --check",
    "styles:min": "node tools/minify-css.mjs",
    "watch": "node tools/watch-assets.mjs",
    "build:assets": "node tools/fingerprint-assets.cjs --clean",
    "build:assets:additive": "node tools/fingerprint-assets.cjs",
    "build:site": "python3 scripts/build.py",
    "qa:media:manifest": "node scripts/qa-media-manifest.mjs"
  },
  "dependencies": {
    "headroom-ai": "^0.22.4"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "bootstrap": "5.3.3",
    "purgecss": "6.0.0",
    "sass": "1.77.8"
  }
}
