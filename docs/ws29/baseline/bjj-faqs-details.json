      "position": "static",
      "href": "/show-up-kit"
    },
    {
      "tag": "SPAN",
      "id": "",
      "classes": "faq-question-text",
      "text": "Can parents watch youth classes?",
      "font": 15.68,
      "width": 226,
      "height": 40.78125,
      "x": 85,
      "y": 4623.15625,
      "position": "static",
      "href": null
    },
    {
      "tag": "P",
      "id": "",
      "classes": "direct-answer fw-semibold text-dark mb-2",
      "text": "Yes. Parents and guardians are always welcome to watch small-group youth classes from comfortable matside seating. Staying to observe helps you see our positive coaching style and watch your child learn.",
      "font": 14.72,
      "width": 226,
      "height": 188.375,
      "x": 85,
      "y": 4679.9375,
      "position": "static",
      "href": null
    },
    {
      "tag": "P",
      "id": "",
      "classes": "text-muted mb-3",
      "text": "We encourage parents to observe how Coach Sandy leads drills and pairs students. You can see how we handle pacing, safety, and encouragement first-hand, and speak with Sandy directly after class.",
      "font": 14.72,
      "width": 226,
      "height": 188.375,
      "x": 85,
      "y": 4880.3125,
      "position": "static",
      "href": null
    },
