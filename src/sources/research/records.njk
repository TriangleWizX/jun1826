---
layout: layouts/base.njk
pagination:
  data: researchSourcePages
  size: 1
  alias: record
permalink: "{{ record.detailUrl }}/index.html"
eleventyComputed:
  title: "{{ record.seoTitle or record.title }} | Source Record"
  keywords: "{{ record.keywords or 'bjj, research, martial arts, source record' }}"
  description: "Source record for {{ record.title }}. It shares the study findings and sets the source scope."
  canonicalUrl: "https://senseisandy.com{{ record.detailUrl }}"
  robots: "index, follow"
---
{% if record.id == "bjj-school-rct" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://senseisandy.com/sources/research/bjj-school-rct#webpage",
  "url": "https://senseisandy.com/sources/research/bjj-school-rct",
  "name": "School-Based BJJ Trial on Behavior | Source Record",
  "citation": {
    "@type": "ScholarlyArticle",
    "@id": {{ ("https://doi.org/" ~ record.doi) | json | safe }},
    "headline": {{ record.title | json | safe }},
    "author": [
      {% for author in record.schemaAuthors %}
      { "@type": "Person", "name": {{ author | json | safe }} }{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    "datePublished": {{ record.year | string | json | safe }},
    "url": {{ record.source | json | safe }}
  }
}
</script>
{% endif %}
<main class="ss-main ss-source-record-main" id="main-content">
  <style>
    .ss-source-record-main {
      background-color: var(--ss-bg, #FBFAF8);
      color: var(--ss-text, #1F1712);
      min-height: 80vh;
    }
    .ss-record-container {
      max-width: 880px;
      margin: 0 auto;
      padding: 2rem 1.25rem 5rem;
    }
    @media (min-width: 768px) {
      .ss-record-container {
        padding: 3.5rem 2rem 6rem;
      }
    }

    /* Breadcrumbs */
    .ss-record-breadcrumbs {
      margin-bottom: 2rem;
    }
    .ss-breadcrumbs-list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      padding: 0;
      margin: 0;
      list-style: none;
      font-size: 0.875rem;
      color: var(--color-muted, #756B5F);
    }
    .ss-breadcrumbs-list a {
      color: var(--ss-slate, #306061);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.15s ease;
    }
    .ss-breadcrumbs-list a:hover {
      color: var(--ss-green, #116A42);
      text-decoration: underline;
    }
    .ss-breadcrumbs-list .separator {
      color: rgba(54, 43, 36, 0.35);
      user-select: none;
    }
    .ss-breadcrumbs-list [aria-current="page"] {
      color: var(--ss-ink, #362B24);
      font-weight: 600;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: min(300px, 60vw);
    }

    /* Badges */
    .ss-record-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
      margin-bottom: 1.25rem;
    }
    .ss-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.3rem 0.8rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1;
    }
    .ss-badge-type {
      background: rgba(17, 106, 66, 0.09);
      color: var(--ss-green, #116A42);
      border: 1px solid rgba(17, 106, 66, 0.22);
    }
    .ss-badge-category {
      background: rgba(40, 159, 161, 0.09);
      color: var(--ss-slate, #306061);
      border: 1px solid rgba(40, 159, 161, 0.22);
    }
    .ss-badge-domain {
      background: var(--ss-surface2, #F4F1ED);
      color: var(--ss-text, #1F1712);
      border: 1px solid var(--ss-border, rgba(54, 43, 36, 0.14));
    }

    /* Header Hero */
    .ss-record-hero {
      margin-bottom: 2rem;
    }
    .ss-record-title {
      font-family: var(--font-display, "Instrument Serif", Georgia, serif);
      font-size: clamp(2.25rem, 5vw, 3.4rem);
      line-height: 1.12;
      color: var(--ss-ink, #362B24);
      letter-spacing: -0.02em;
      margin-top: 0;
      margin-bottom: 0.85rem;
      font-weight: 400;
    }
    .ss-record-subtitle {
      font-size: clamp(1.1rem, 2.5vw, 1.3rem);
      line-height: 1.55;
      color: var(--ss-muted, #4F433C);
      margin-bottom: 1.5rem;
      max-width: 760px;
    }

    /* Meta Bar */
    .ss-record-meta-bar {
      background-color: var(--ss-surface, #FFFFFF);
      border: 1px solid var(--ss-border, rgba(54, 43, 36, 0.14));
      border-radius: 1rem;
      padding: 1.25rem 1.5rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.25rem;
      box-shadow: 0 2px 10px rgba(54, 43, 36, 0.03);
      margin-bottom: 2rem;
    }
    .ss-meta-item {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .ss-meta-label {
      font-size: 0.725rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-muted, #756B5F);
    }
    .ss-meta-val {
      font-size: 0.95rem;
      line-height: 1.45;
      color: var(--ss-ink, #362B24);
    }

    /* Quick Action Buttons */
    .ss-record-quick-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 3rem;
    }
    .ss-action-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.65rem 1.25rem;
      border-radius: 999px;
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.15s ease;
      line-height: 1.3;
    }
    .ss-action-pill-primary {
      background-color: var(--ss-green, #116A42);
      color: #FFFFFF !important;
      box-shadow: 0 2px 8px rgba(17, 106, 66, 0.2);
    }
    .ss-action-pill-primary:hover {
      background-color: var(--color-accent-strong, #0D5736);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(17, 106, 66, 0.25);
    }
    .ss-action-pill-outline {
      background-color: var(--ss-surface, #FFFFFF);
      color: var(--ss-ink, #362B24) !important;
      border: 1px solid var(--ss-border, rgba(54, 43, 36, 0.18));
    }
    .ss-action-pill-outline:hover {
      background-color: var(--ss-surface2, #F4F1ED);
      border-color: rgba(54, 43, 36, 0.35);
    }
    .ss-action-pill-secondary {
      background-color: rgba(40, 159, 161, 0.1);
      color: var(--ss-slate, #306061) !important;
      border: 1px solid rgba(40, 159, 161, 0.25);
    }
    .ss-action-pill-secondary:hover {
      background-color: rgba(40, 159, 161, 0.18);
    }

    /* Human Guide Section */
    .ss-human-guide-wrapper {
      background: var(--ss-surface, #FFFFFF);
      border: 1px solid var(--ss-border, rgba(54, 43, 36, 0.14));
      border-radius: 1.5rem;
      padding: 2rem 1.5rem;
      margin: 3rem 0;
      box-shadow: 0 6px 24px rgba(54, 43, 36, 0.04);
      position: relative;
    }
    @media (min-width: 768px) {
      .ss-human-guide-wrapper {
        padding: 3rem 2.5rem;
      }
    }
    .ss-guide-header-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(17, 106, 66, 0.08);
      color: var(--ss-green, #116A42);
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      font-size: 0.775rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }
    .ss-human-guide-content h2 {
      font-family: var(--font-display, "Instrument Serif", Georgia, serif);
      font-size: clamp(1.85rem, 4vw, 2.4rem);
      line-height: 1.2;
      color: var(--ss-green, #116A42) !important;
      font-weight: 400;
      margin-top: 0;
      margin-bottom: 1.5rem;
    }
    .ss-human-guide-content h3 {
      font-family: var(--font-body, "Lexend", sans-serif);
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--ss-ink, #362B24);
      margin-top: 2.25rem;
      margin-bottom: 0.85rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid rgba(54, 43, 36, 0.08);
    }
    .ss-human-guide-content p {
      font-size: 1.05rem;
      line-height: 1.72;
      color: var(--ss-text, #1F1712);
      margin-bottom: 1.25rem;
    }
    .ss-human-guide-content p strong {
      color: var(--ss-ink, #362B24);
      font-weight: 700;
    }
    .ss-human-guide-content p strong:first-child {
      display: block;
      margin-bottom: 0.25rem;
      font-size: 1.05rem;
    }

    /* Study Summary & Parameters Section */
    .ss-academic-scope {
      margin: 3.5rem 0;
    }
    .ss-scope-header {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.75rem;
    }
    .ss-eyebrow-scope {
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ss-slate, #306061);
      margin-bottom: 0.25rem;
      display: block;
    }
    .ss-scope-title {
      font-family: var(--font-display, "Instrument Serif", Georgia, serif);
      font-size: clamp(1.85rem, 4vw, 2.4rem);
      color: var(--ss-ink, #362B24);
      margin: 0;
      font-weight: 400;
    }

    /* Cards Grid */
    .ss-scope-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    @media (min-width: 768px) {
      .ss-scope-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    .ss-scope-card {
      background: var(--ss-surface, #FFFFFF);
      border: 1px solid var(--ss-border, rgba(54, 43, 36, 0.14));
      border-radius: 1rem;
      padding: 1.5rem;
      box-shadow: 0 2px 10px rgba(54, 43, 36, 0.02);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }
    .ss-card-full {
      grid-column: 1 / -1;
    }
    .ss-scope-card-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-muted, #756B5F);
      margin-bottom: 0.6rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .ss-scope-card-body {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--ss-text, #1F1712);
      margin: 0;
    }

    /* Key Findings Card (Emerald Highlight) */
    .ss-card-found {
      background: #F4F8F5;
      border: 1.5px solid rgba(17, 106, 66, 0.28);
      border-left: 6px solid var(--ss-green, #116A42);
      box-shadow: 0 4px 16px rgba(17, 106, 66, 0.06);
    }
    .ss-card-found .ss-scope-card-label {
      color: var(--ss-green, #116A42);
      font-weight: 800;
      font-size: 0.8rem;
    }
    .ss-card-found .ss-scope-card-body {
      font-size: 1.1rem;
      line-height: 1.65;
      color: #0E472A;
      font-weight: 500;
    }
    .ss-detailed-results {
      margin-top: 1rem;
      padding-top: 0.85rem;
      border-top: 1px solid rgba(17, 106, 66, 0.15);
      font-size: 0.925rem;
      line-height: 1.55;
      color: #175233;
    }

    /* Study Limits Card (Amber Highlight) */
    .ss-card-limits {
      background: #FDFAF5;
      border: 1.5px solid rgba(184, 138, 68, 0.32);
      border-left: 6px solid #B88A44;
      box-shadow: 0 4px 16px rgba(184, 138, 68, 0.06);
    }
    .ss-card-limits .ss-scope-card-label {
      color: var(--ss-brown, #8B522E);
      font-weight: 800;
      font-size: 0.8rem;
    }
    .ss-card-limits .ss-scope-card-body {
      font-size: 1.05rem;
      line-height: 1.65;
      color: #4D331E;
    }

    /* Audit Verification Card */
    .ss-card-audit {
      background: var(--ss-surface2, #F4F1ED);
      border: 1px solid var(--ss-border, rgba(54, 43, 36, 0.14));
    }

    /* Citations Action Row */
    .ss-citation-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.25rem;
      padding: 1.25rem 1.5rem;
      background: var(--ss-surface, #FFFFFF);
      border: 1px solid var(--ss-border, rgba(54, 43, 36, 0.14));
      border-radius: 1rem;
      margin-top: 2.5rem;
    }
    .ss-citation-link {
      color: var(--ss-slate, #306061);
      font-weight: 600;
      font-size: 0.925rem;
      text-decoration: underline;
      text-underline-offset: 3px;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: color 0.15s ease;
    }
    .ss-citation-link:hover {
      color: var(--ss-green, #116A42);
    }

    /* Studio Connection Bridge (Double-Bezel Design) */
    .ss-studio-bridge-outer {
      background-color: var(--ss-border, rgba(54, 43, 36, 0.14));
      padding: 0.375rem;
      border-radius: 1.75rem;
      margin-top: 4rem;
      box-shadow: 0 10px 30px rgba(54, 43, 36, 0.05);
    }
    .ss-studio-bridge-inner {
      background-color: var(--ss-surface, #FFFFFF);
      border-radius: calc(1.75rem - 0.375rem);
      padding: 2.25rem 1.75rem;
    }
    @media (min-width: 768px) {
      .ss-studio-bridge-inner {
        padding: 3rem 2.5rem;
      }
    }
    .ss-bridge-eyebrow {
      color: var(--ss-green, #116A42);
      font-weight: 800;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.4rem;
      display: block;
    }
    .ss-bridge-title {
      font-family: var(--font-display, "Instrument Serif", Georgia, serif);
      font-size: clamp(1.85rem, 4vw, 2.5rem);
      color: var(--ss-ink, #362B24);
      margin-top: 0;
      margin-bottom: 0.85rem;
      line-height: 1.15;
    }
    .ss-bridge-desc {
      font-size: 1.05rem;
      line-height: 1.65;
      color: var(--ss-muted, #4F433C);
      margin-bottom: 1.75rem;
      max-width: 680px;
    }
    .ss-bridge-ctas {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
    }
    .ss-btn-reserve {
      background-color: var(--ss-green, #116A42);
      color: #FFFFFF !important;
      padding: 0.85rem 1.75rem;
      border-radius: 999px;
      font-size: 1rem;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(17, 106, 66, 0.25);
      transition: all 0.15s ease;
    }
    .ss-btn-reserve:hover {
      background-color: var(--color-accent-strong, #0D5736);
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(17, 106, 66, 0.3);
    }
    .ss-btn-sms {
      background-color: transparent;
      color: var(--ss-ink, #362B24) !important;
      border: 1.5px solid var(--ss-border, rgba(54, 43, 36, 0.2));
      padding: 0.8rem 1.5rem;
      border-radius: 999px;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .ss-btn-sms:hover {
      background-color: var(--ss-surface2, #F4F1ED);
      border-color: rgba(54, 43, 36, 0.35);
    }
    .ss-bridge-schedule-link {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--ss-slate, #306061);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .ss-bridge-schedule-link:hover {
      color: var(--ss-green, #116A42);
    }
  </style>

  <div class="ss-record-container">
    <!-- Breadcrumbs -->
    <nav class="ss-record-breadcrumbs" aria-label="Breadcrumb">
      <ol class="ss-breadcrumbs-list">
        <li><a href="/">Home</a></li>
        <li class="separator" aria-hidden="true">›</li>
        <li><a href="/evidence">Evidence &amp; Research</a></li>
        <li class="separator" aria-hidden="true">›</li>
        <li aria-current="page">{{ record.displayTitle or record.title }}</li>
      </ol>
    </nav>

    <!-- Header Badges -->
    <div class="ss-record-badges">
      <span class="ss-badge ss-badge-type">{{ record.evidenceType | replace('-', ' ') }}</span>
      <span class="ss-badge ss-badge-category">{{ record.category | replace('-', ' ') }}</span>
      <span class="ss-badge ss-badge-domain">{{ record.sport }}</span>
    </div>

    <!-- Hero Title & Subtitle -->
    <header class="ss-record-hero">
      <h1 class="ss-record-title">{{ record.displayTitle or record.title }}</h1>
      {% if record.displaySubtitle %}
      <p class="ss-record-subtitle">{{ record.displaySubtitle }}</p>
      {% endif %}
    </header>

    <!-- Meta Information Bar -->
    <div class="ss-record-meta-bar">
      {% if record.authors %}
      <div class="ss-meta-item">
        <span class="ss-meta-label">Authors</span>
        <span class="ss-meta-val">{{ record.authors }}</span>
      </div>
      {% endif %}
      <div class="ss-meta-item">
        <span class="ss-meta-label">Publication</span>
        <span class="ss-meta-val">{{ record.publicationDate }}</span>
      </div>
      <div class="ss-meta-item">
        <span class="ss-meta-label">Evidence Audit</span>
        <span class="ss-meta-val">Verified {{ record.verifiedAt }} · Next Review: {{ record.staleAfter }}</span>
      </div>
    </div>

    <!-- Quick Action Pills -->
    <div class="ss-record-quick-actions">
      <a href="{{ record.source }}" rel="noopener" target="_blank" class="ss-action-pill ss-action-pill-primary">
        <i class="bi bi-box-arrow-up-right"></i> Read Original Journal Article {% if record.doi %}<span>(DOI: {{ record.doi }})</span>{% endif %}
      </a>
      <a href="/evidence" class="ss-action-pill ss-action-pill-outline">
        <i class="bi bi-arrow-left"></i> Evidence Overview
      </a>
      {% if record.contextualUrl %}
      <a href="{{ record.contextualUrl }}" class="ss-action-pill ss-action-pill-secondary">
        <i class="bi bi-shield-check"></i> {{ record.contextualLinkText }}
      </a>
      {% endif %}
    </div>

    <!-- Plain Language Guide for Families & Beginners -->
    {% if record.humanGuide %}
    <section class="ss-human-guide-wrapper" aria-label="Plain language guide for families">
      <div class="ss-guide-header-badge">
        <i class="bi bi-compass"></i> Plain-English Summary
      </div>
      <div class="ss-human-guide-content">
        {{ record.humanGuide | safe }}
      </div>
    </section>
    {% endif %}

    <!-- Academic Methodology & Scope -->
    {% if record.positiveResearchPage %}
    <script type="application/ld+json">{{ {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      "headline": record.title,
      "author": record.authors,
      "datePublished": record.publicationDate,
      "url": "https://senseisandy.com" + record.detailUrl,
      "sameAs": record.source,
      "identifier": record.doi,
      "isPartOf": {"@type": "CreativeWorkSeries", "name": "Sensei Sandy BJJ Research Source Records", "url": "https://senseisandy.com/sources"}
    } | json | safe }}</script>
    <section class="ss-academic-scope" aria-labelledby="academic-scope-title">
      <div class="ss-scope-header"><div>
        <span class="ss-eyebrow-scope">Source record</span>
        <h2 id="academic-scope-title" class="ss-scope-title">Study Summary &amp; Academic Scope</h2>
      </div></div>
      <div class="ss-scope-grid">
        <div class="ss-scope-card ss-card-full"><div class="ss-scope-card-label">Source and method</div>
          <p class="ss-scope-card-body">{{ record.evidenceType | replace('-', ' ') | capitalize }}. {{ record.intervention.description }}. The source covers {{ record.population.ageGroup }}.</p>
        </div>
        <div class="ss-scope-card ss-card-found ss-card-full"><div class="ss-scope-card-label">What the source reports</div>
          <p class="ss-scope-card-body">{{ record.found }}</p>
        </div>
        <div class="ss-scope-card ss-card-full"><div class="ss-scope-card-label">Scope of this source</div>
          <p class="ss-scope-card-body">{{ record.notTested }}</p>
        </div>
      </div>
    </section>
    {% else %}
    <section class="ss-academic-scope" aria-labelledby="academic-scope-title">
      <div class="ss-scope-header">
        <div>
          <span class="ss-eyebrow-scope">Academic Verification</span>
          <h2 id="academic-scope-title" class="ss-scope-title">Study Summary &amp; Academic Scope</h2>
        </div>
      </div>

      <div class="ss-scope-grid">
        {% if record.displayTitle %}
        <div class="ss-scope-card ss-card-full">
          <div class="ss-scope-card-label">
            <i class="bi bi-journal-text"></i> Original Paper Title
          </div>
          <p class="ss-scope-card-body">{{ record.title }}</p>
        </div>
        {% endif %}

        <div class="ss-scope-card">
          <div class="ss-scope-card-label">
            <i class="bi bi-trophy"></i> Sport &amp; Domain
          </div>
          <p class="ss-scope-card-body">{{ record.sport }}</p>
        </div>

        <div class="ss-scope-card">
          <div class="ss-scope-card-label">
            <i class="bi bi-people"></i> Population Covered
          </div>
          <p class="ss-scope-card-body">
            {{ record.population.ageGroup }}{% if record.population.n %}; {{ record.population.n }} participants{% endif %}{% if record.population.nEnrolled %}; {{ record.population.nEnrolled }} enrolled{% endif %}{% if record.population.nAnalyzed %}; {{ record.population.nAnalyzed }} analyzed{% endif %}{% if record.population.groups %}; {{ record.population.groups }} groups{% endif %}{% if record.population.studies %}; {{ record.population.studies }} studies{% endif %}.
          </p>
        </div>

        <div class="ss-scope-card">
          <div class="ss-scope-card-label">
            <i class="bi bi-diagram-3"></i> What Was Studied (Intervention)
          </div>
          <p class="ss-scope-card-body">
            {{ record.intervention.description }}{% if record.intervention.durationWeeks %}; {{ record.intervention.durationWeeks }} weeks{% endif %}{% if record.intervention.sessionsPerWeek %}; {{ record.intervention.sessionsPerWeek }} times each week{% endif %}{% if record.intervention.minutesPerSession %}; {{ record.intervention.minutesPerSession }} minutes per session{% endif %}.
          </p>
        </div>

        <div class="ss-scope-card">
          <div class="ss-scope-card-label">
            <i class="bi bi-clipboard-data"></i> What It Measured
          </div>
          <p class="ss-scope-card-body">{{ record.tested }}</p>
        </div>

        <!-- Key Findings Card -->
        <div class="ss-scope-card ss-card-found ss-card-full">
          <div class="ss-scope-card-label">
            <i class="bi bi-check2-circle"></i> What the Source Reports (Key Findings)
          </div>
          <p class="ss-scope-card-body">{{ record.found }}</p>
          {% if record.detailedResults %}
          <div class="ss-detailed-results">
            <strong>Selected detailed results:</strong> {{ record.detailedResults }}
          </div>
          {% endif %}
        </div>

        <!-- Limits & Non-Tested Scope Card -->
        <div class="ss-scope-card ss-card-limits ss-card-full">
          <div class="ss-scope-card-label">
            <i class="bi bi-shield-slash"></i> What It Does Not Show (Limits &amp; Boundaries)
          </div>
          <p class="ss-scope-card-body">{{ record.notTested }}</p>
        </div>

        <!-- Review & Verification Card -->
        <div class="ss-scope-card ss-card-audit ss-card-full">
          <div class="ss-scope-card-label">
            <i class="bi bi-calendar-check"></i> Verification Protocol
          </div>
          <p class="ss-scope-card-body small text-muted">
            Verified {{ record.verifiedAt }} · review again {{ record.staleAfter }}.
          </p>
        </div>
      </div>
    </section>
    {% endif %}

    <!-- Source Links & Citations Bar -->
    <div class="ss-citation-row">
      <a href="{{ record.source }}" rel="noopener" target="_blank" class="ss-citation-link">
        <i class="bi bi-box-arrow-up-right"></i> Read the source{% if record.doi %} (DOI: {{ record.doi }}){% endif %}
      </a>
      <a href="/evidence" class="ss-citation-link">
        <i class="bi bi-arrow-left"></i> Return to the evidence explanation
      </a>
      {% if record.contextualUrl %}
      <a href="{{ record.contextualUrl }}" class="ss-citation-link">
        <i class="bi bi-shield-check"></i> {{ record.contextualLinkText }}
      </a>
      {% endif %}
    </div>

    <!-- Studio Connection Bridge -->
    <aside class="ss-studio-bridge-outer" aria-labelledby="studio-bridge-heading">
      <div class="ss-studio-bridge-inner">
        <span class="ss-bridge-eyebrow">On the Mat in Tannersville</span>
        <h3 id="studio-bridge-heading" class="ss-bridge-title">Experience Coached Movement on the Mats</h3>
        <p class="ss-bridge-desc">
          At Sensei Sandy BJJ, we translate motor-learning research into calm, guided practice for kids, teens, and adults. Coached resistance games begin at the right pace from day one—structured, safe, and ego-free.
        </p>
        <div class="ss-bridge-ctas">
          <a href="/free-bjj-intro-tannersville-ny#booking-flow" class="ss-btn-reserve">
            Reserve Free First Visit
          </a>
          <a href="sms:+19177368649" class="ss-btn-sms">
            <i class="bi bi-chat-dots me-1"></i> Text Sandy: (917) 736-8649
          </a>
          <a href="/schedule" class="ss-bridge-schedule-link">
            View Class Schedule <i class="bi bi-arrow-right"></i>
          </a>
        </div>
      </div>
    </aside>
  </div>
</main>
