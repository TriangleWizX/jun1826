---
layout: layouts/base.njk
pagination:
  data: researchSourcePages
  size: 1
  alias: record
permalink: "{{ record.detailUrl }}index.html"
eleventyComputed:
  title: "{{ record.title }} | Source Record"
  description: "Source record for {{ record.title }}. It summarizes what the study or article reports and what it cannot show about Sensei Sandy BJJ."
  canonicalUrl: "https://senseisandy.com{{ record.detailUrl }}"
  robots: "noindex, follow"
---
<main class="ss-main" id="main-content">
  <div class="container py-5">
    <p class="text-uppercase small text-muted">{{ record.evidenceType | replace('-', ' ') }} · {{ record.category | replace('-', ' ') }}</p>
    <h1>{{ record.title }}</h1>
    <p>{{ record.authors }} · {{ record.publicationDate }}</p>
    <dl>
      <dt>Who or what was covered</dt>
      <dd>{{ record.population.ageGroup }}{% if record.population.n %}; {{ record.population.n }} participants{% endif %}{% if record.population.studies %}; {{ record.population.studies }} studies{% endif %}.</dd>
      <dt>What was studied</dt>
      <dd>{{ record.intervention.description }}{% if record.intervention.durationWeeks %}; {{ record.intervention.durationWeeks }} weeks{% endif %}{% if record.intervention.sessionsPerWeek %}; {{ record.intervention.sessionsPerWeek }} times each week{% endif %}{% if record.intervention.minutesPerSession %}; {{ record.intervention.minutesPerSession }} minutes per session{% endif %}.</dd>
      <dt>What it measured</dt>
      <dd>{{ record.tested }}</dd>
      <dt>What the source reports</dt>
      <dd>{{ record.found }}</dd>
      <dt>What it does not show</dt>
      <dd>{{ record.notTested }}</dd>
      <dt>Verified</dt>
      <dd>{{ record.verifiedAt }} · review again {{ record.staleAfter }}</dd>
    </dl>
    <p><a href="{{ record.source }}" rel="noopener">Read the source{% if record.doi %} (DOI: {{ record.doi }}){% endif %}</a> · <a href="/evidence">Return to the evidence explanation</a></p>
  </div>
</main>
