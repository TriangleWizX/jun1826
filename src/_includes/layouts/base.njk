<!DOCTYPE html>
<html lang="en">
<head>
  {% include "components/head-metadata.njk" %}
  {% if headExtra %}
    {{ headExtra | safe }}
  {% endif %}
</head>
<body class="{{ bodyClass | default("ss-page") }}"{% if audience %} data-audience="{{ audience }}"{% endif %}>

  {% include "components/header.njk" %}

  {% if promotions.promotions[0].active %}
    {% include "components/promotion-banner.njk" %}
  {% endif %}

  <div id="scrollProgress"></div>

  {% if "<main" in content %}
    {{ content | stripDocumentShell | safe }}
  {% else %}
    <main class="ss-main {{ mainClass | default("") }}" id="main-content" role="main">
      {{ content | stripDocumentShell | safe }}
    </main>
  {% endif %}

  {% if footerSsi %}
    <!--#include virtual="/footer-include.html" -->
  {% else %}
    {% include "components/footer.njk" %}
  {% endif %}

<script src="/js/link-utils.min.js" defer></script>
<script src="/js/analytics-events.min.js" defer></script>
  {% if bodyExtra %}
    {{ bodyExtra | safe }}
  {% endif %}
</body>
</html>
