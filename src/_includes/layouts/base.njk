<!DOCTYPE html>
<html lang="en">
<head>
  {% include "components/head-metadata.njk" %}
  {% if headExtra %}
    {{ headExtra | safe }}
  {% endif %}
</head>
<body class="{{ bodyClass | default("ss-page") }}">

  {% include "components/header.njk" %}

  {% if promotions.promotions[0].active %}
    {% include "components/promotion-banner.njk" %}
  {% endif %}

  <div id="scrollProgress"></div>

  {% if "<main" in content %}
    {{ content | safe }}
  {% else %}
    <main class="ss-main {{ mainClass | default("") }}" id="main-content" role="main">
      {{ content | safe }}
    </main>
  {% endif %}

  {% if footerSsi %}
    <!--#include virtual="/footer-include.html" -->
  {% else %}
    {% include "components/footer.njk" %}
  {% endif %}

  <script src="/assets/js/attribution.js" defer fetchpriority="low"></script>
  <script src="/assets/js/analytics-events.js" defer fetchpriority="low"></script>
  {% if bodyExtra %}
    {{ bodyExtra | safe }}
  {% endif %}
</body>
</html>
