<script>
  document.addEventListener("DOMContentLoaded", function () {
    (function initStickyVisibility() {
      const heroCta = document.querySelector([
        '.home-hero .primary-cta',
        '.hero-card .btn-white-secondary',
        '.hero-card .btn-green-primary',
        '.ss-hero .primary-cta',
        '#hero-cta',
        '.program-hero .hero-actions .btn-primary',
        '.program-hero [data-goal-mapping]',
        '.ss-near-hero .he-btn-wrapper'
      ].join(', '));
      const footerCta = document.querySelector('footer, .ss-new-site-footer, .ss-site-footer, .ss-cta-footer-section');
      const stickyCta = document.querySelector('.ss-mobile-actionbar');

      if (!stickyCta) return;
      stickyCta.classList.add("is-observed");
      if (!("IntersectionObserver" in window)) {
        stickyCta.classList.add("is-visible");
        return;
      }

      let heroOut = !heroCta;
      let footerIn = false;
      const updateVisibility = function () {
        stickyCta.classList.toggle("is-visible", heroOut && !footerIn);
      };

      if (heroCta) {
        const heroObserver = new IntersectionObserver(function (entries) {
          heroOut = !entries[0].isIntersecting;
          updateVisibility();
        }, { threshold: 0.1 });
        heroObserver.observe(heroCta);
      }

      if (footerCta) {
        const footerObserver = new IntersectionObserver(function (entries) {
          footerIn = entries[0].isIntersecting;
          updateVisibility();
        }, { threshold: 0.05 });
        footerObserver.observe(footerCta);
      }

      updateVisibility();
    })();
  });
</script>
