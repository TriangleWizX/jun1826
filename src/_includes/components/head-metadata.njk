<template id="ss-progressive-stylesheets">
  <link rel="stylesheet" href="/assets/css/bootstrap-icons-local.css" data-w21-stylesheet>
  <link rel="stylesheet" href="/assets/css/fonts.min.css" data-w21-stylesheet data-w21-desktop-only>
  <link rel="stylesheet" href="/assets/css/site-shell.min.css" data-w21-stylesheet>
{% if extraCss %}
{% for cssFile in extraCss %}
  <link rel="stylesheet" href="{{ cssFile }}" data-w21-stylesheet>
{% endfor %}
{% endif %}
</template>
<script>
(() => {
  const template = document.getElementById("ss-progressive-stylesheets");
  if (!template) return;

  let observer = null;
  const media = window.matchMedia ? window.matchMedia("(max-width: 767px)") : null;
  const mobile = media ? media.matches : false;
  const events = ["pointerdown", "keydown", "focusin", "scroll", "click"];
  const appended = new Set();
  function appendAvailableStylesheets(renderBlocking, desktop) {
    for (const source of template.content.querySelectorAll("link[data-w21-stylesheet]")) {
      if (source.hasAttribute("data-w21-desktop-only") && !desktop) continue;
      const href = source.getAttribute("href");
      if (appended.has(href)) continue;
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = href;
      if (renderBlocking) link.setAttribute("blocking", "render");
      document.head.append(link);
      appended.add(href);
    }
  }
  function cleanup() {
    if (observer) observer.disconnect();
    for (const eventName of events) window.removeEventListener(eventName, loadNow, true);
  }
  function attachStylesheets(renderBlocking) {
    const desktop = window.matchMedia ? !window.matchMedia("(max-width: 767px)").matches : true;
    cleanup();
    appendAvailableStylesheets(renderBlocking || desktop, desktop);
  }
  function loadNow() { attachStylesheets(false); }
  window.addEventListener("resize", () => {
    if (window.matchMedia && !window.matchMedia("(max-width: 767px)").matches) {
      attachStylesheets(true);
    }
  }, true);

  if (!mobile) {
    attachStylesheets(true);
    return;
  }

  const paintSupported = window.PerformanceObserver &&
    Array.isArray(PerformanceObserver.supportedEntryTypes) &&
    PerformanceObserver.supportedEntryTypes.includes("paint");
  if (!paintSupported) {
    attachStylesheets(false);
    return;
  }

  for (const eventName of events) window.addEventListener(eventName, loadNow, true);
  try {
    observer = new PerformanceObserver((list) => {
      if (list.getEntries().some((entry) => entry.name === "first-contentful-paint")) {
        attachStylesheets(false);
      }
    });
    observer.observe({ type: "paint", buffered: true });
  } catch {
    attachStylesheets(false);
  }
})();
</script>
