<div class="table-responsive ss-schedule-table-wrapper">
  <table class="table table-bordered align-middle text-center mb-0">
    <thead class="table-dark">
      <tr>
        <th scope="col">Day</th>
        <th scope="col">Youth &amp; Teens (Ages 5–17)</th>
        <th scope="col">Adults (Ages 18+)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Monday</th>
        <td><span class="badge bg-primary me-1">Gi</span> 5:00 PM</td>
        <td><span class="badge bg-primary me-1">Gi</span> 6:00 PM</td>
      </tr>
      <tr>
        <th scope="row">Tuesday</th>
        <td><span class="badge bg-primary me-1">Gi</span> 5:00 PM</td>
        <td><span class="badge bg-primary me-1">Gi</span> 6:00 PM</td>
      </tr>
      <tr>
        <th scope="row">Wednesday</th>
        <td><span class="badge bg-secondary me-1">No-Gi</span> 5:00 PM</td>
        <td><span class="badge bg-secondary me-1">No-Gi</span> 6:00 PM</td>
      </tr>
      <tr>
        <th scope="row">Thursday</th>
        <td colspan="2" class="text-muted italic">Private Coaching &amp; Mat Maintenance</td>
      </tr>
      <tr>
        <th scope="row">Friday</th>
        <td><span class="badge bg-primary me-1">Gi</span> 5:00 PM</td>
        <td><span class="badge bg-primary me-1">Gi</span> 6:00 PM</td>
      </tr>
      <tr>
        <th scope="row">Saturday</th>
        <td class="text-muted">By Approval</td>
        <td><span class="badge bg-secondary me-1">No-Gi</span> 10:30 AM</td>
      </tr>
      <tr>
        <th scope="row">Sunday</th>
        <td colspan="2" class="text-muted">Closed / Rest</td>
      </tr>
    </tbody>
  </table>
</div>
