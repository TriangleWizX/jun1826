{% if schemaUrl == "https://senseisandy.com/bjj-faqs" or schemaUrl == "https://senseisandy.com/bjj-faqs.html" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faqs %}
    {
      "@type": "Question",
      "name": {{ item.question | json | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ (item.summary ~ " " ~ item.answer) | json | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
