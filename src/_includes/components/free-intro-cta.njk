<div class="ss-free-intro-cta-block text-center py-4 px-3" style="background: var(--ss-surface2, #F4F1ED); border-radius: 16px; margin: 2rem 0;">
  <h2 class="h3 font-weight-bold" style="color: var(--ss-ink, #362B24);">Start With a Free Coached Class</h2>
  <p class="text-muted max-w-2xl mx-auto mb-4">Every new student begins with a 15-minute Goal Mapping visit to tour the studio, meet Sandy, and select the right class for your schedule.</p>
  <div class="d-flex flex-wrap justify-content-center gap-3">
    <a href="{{ business.primaryCta.url }}" class="btn btn-primary btn-lg ss-btn">
      {{ business.primaryCta.label }}
      <i class="bi bi-arrow-right" aria-hidden="true"></i>
    </a>
    <a href="{{ contact.smsHref }}" class="btn btn-outline-secondary btn-lg ss-btn ss-btn--ghost">
      Text Sandy {{ contact.phoneFormatted }}
    </a>
  </div>
</div>
