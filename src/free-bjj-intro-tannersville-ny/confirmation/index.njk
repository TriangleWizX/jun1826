    <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
      <a href="/schedule" class="btn btn-primary btn-lg ss-btn">
        View Studio Schedule
        <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>
      </a>
      <a href="sms:+19177368649?body=Hi%20Sandy%2C%20I%20just%20submitted%20a%20Free%20Intro%20request!" class="btn btn-outline-secondary btn-lg ss-btn ss-btn--ghost">
        Text Sandy Directly (917) 736-8649
      </a>
    </div>
