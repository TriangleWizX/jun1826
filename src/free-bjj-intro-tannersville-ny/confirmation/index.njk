<!-- Confirmation details branch by profile and are published with the booking route. -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  const details = JSON.parse(sessionStorage.getItem("ss_first_visit_details") || "null");
  if (details?.profile === "adult-beginner" || details?.profile === "adult") document.querySelector("[data-confirmation-youth]")?.remove();
  if (["child", "teen"].includes(details?.profile)) document.querySelector("[data-confirmation-adult]")?.remove();
  if (details?.selectedClass) {
    const panel = document.querySelector("#first-visit-details");
    const copy = document.querySelector("[data-confirmation-details]");
    const youth = ["child", "teen"].includes(details.profile);
    if (copy) copy.textContent = youth ? `${details.selectedClass}. Arrive 20 minutes before class in clean athletic clothes. Parent stays on site. Address: 6045 Main Street, 2nd Floor Studio, Tannersville, NY 12485.` : `Your 15-minute First Visit: ${details.selectedClass}. Wear normal clothes; no workout. Address: 6045 Main Street, 2nd Floor Studio, Tannersville, NY 12485.`;
    if (panel) panel.hidden = false;
  }
  // Fire generate_lead event ONLY once using sessionStorage deduplication flag
  if (!sessionStorage.getItem("ss_lead_fired")) {
    sessionStorage.setItem("ss_lead_fired", "true");
    if (window.SS_TRACK_EVENT) {
      window.SS_TRACK_EVENT("generate_lead", {
        form_id: "ss-free-intro-form",
        form_location: "free_intro_page",
        page_type: "confirmation"
      });
    }
  }
});
</script>
