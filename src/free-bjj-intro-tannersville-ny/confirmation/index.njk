---
layout: layouts/base.njk
title: "Free First Visit Request Received | Sensei Sandy BJJ"
description: "Thank you for requesting a Free First Visit at Sensei Sandy BJJ in Tannersville, NY. Sandy will call or text you shortly."
canonicalUrl: "/free-bjj-intro-tannersville-ny/confirmation/"
robots: "noindex, follow"
permalink: "/free-bjj-intro-tannersville-ny/confirmation/index.html"
---

<main class="container py-5 my-4" id="main-content">
  <div class="mx-auto text-center" style="max-width: 44rem;">
    <p class="text-uppercase small fw-bold text-success">Request received</p>
    <h1>We received your Free First Visit request.</h1>
    <p class="lead text-muted">Sandy will call or text you to confirm the visit before you arrive.</p>

    <section class="card border-0 shadow-sm p-4 text-start rounded-4 my-4" aria-labelledby="next-step-title">
      <h2 class="h4" id="next-step-title">What happens next</h2>
      <ol class="mb-0">
        <li class="mb-2">Sandy confirms the visit and answers any questions.</li>
        <li class="mb-2" data-confirmation-adult><strong>Adults:</strong> Your 15-minute visit is in normal clothes. There is no workout. Sandy schedules the coached first class afterward.</li>
        <li class="mb-2" data-confirmation-youth><strong>Children and teens:</strong> Arrive 20 minutes before the class Sandy confirms, in clean athletic clothes. Review safety first; the student may train that day.</li>
        <li>Check the <a href="/schedule">current schedule</a> and <a href="/bjj-tannersville-ny-directions">studio directions</a> before your visit.</li>
      </ol>
      <div id="first-visit-details" class="mt-3 pt-3 border-top" hidden>
        <strong>Your preferred time</strong>
        <p class="small mb-0 mt-2" data-confirmation-details></p>
      </div>
    </section>

    <div class="d-flex flex-wrap justify-content-center gap-3">
      <a href="/schedule" class="btn btn-primary btn-lg">View the schedule</a>
      <a href="{{ contact.smsHref }}" class="btn btn-outline-secondary btn-lg">Text Sandy</a>
    </div>
  </div>
</main>

<script>
document.addEventListener("DOMContentLoaded", function () {
  let details = null;
  try {
    const stored = JSON.parse(sessionStorage.getItem("ss_first_visit_details") || "null");
    const isRecent = Number.isFinite(stored?.submittedAt) && Date.now() - stored.submittedAt < 86400000;
    if (isRecent && typeof stored?.profile === "string" && typeof stored?.selectedClass === "string") details = stored;
  } catch (_) { /* The generic confirmation remains usable without storage. */ }

  const isYouth = ["child", "teen", "family"].includes(details?.profile);
  const isFamily = details?.profile === "family";
  const isAdult = ["adult-beginner", "adult", "leo", "community-service"].includes(details?.profile);
  if (isAdult) document.querySelector("[data-confirmation-youth]")?.remove();
  if (isYouth && !isFamily) document.querySelector("[data-confirmation-adult]")?.remove();

  if (details?.selectedClass) {
    const panel = document.querySelector("#first-visit-details");
    const copy = document.querySelector("[data-confirmation-details]");
    if (copy) copy.textContent = details.selectedClass;
    if (panel) panel.hidden = false;
  }

  try {
    if (!sessionStorage.getItem("ss_lead_fired")) {
      sessionStorage.setItem("ss_lead_fired", "true");
      window.SS_TRACK_EVENT?.("generate_lead", {
        form_id: "ss-free-intro-form",
        form_location: "free_intro_page",
        page_type: "confirmation"
      });
    }
  } catch (_) { /* Confirmation content does not depend on analytics storage. */ }
});
</script>
